generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COACH
  CLIENT
}

model User {
  id        String   @id @default(cuid())

  email     String   @unique
  name      String?

  role      UserRole @default(CLIENT)

  password  String?

  avatar    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  healthData    HealthData[]
  healthMetrics HealthMetric[]
  workouts      Workout[]
  providers     ConnectedProvider[]
}

model HealthData {
  id String @id @default(cuid())

  type String

  value Float

  unit String?

  source String?

  deviceId String?

  recordedAt DateTime

  createdAt DateTime @default(now())

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthRecord {
  id String @id @default(cuid())

  provider String

  steps Int?

  calories Int?

  distance Float?

  heartRate Int?

  sleepDuration Int?

  weight Float?

  bodyFat Float?

  recordedAt DateTime

  createdAt DateTime @default(now())
}

model HealthMetric {
  id String @id @default(cuid())

  type String

  value Float

  unit String?

  source String

  deviceId String?

  recordedAt DateTime

  createdAt DateTime @default(now())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, source, recordedAt], name: "health_metric_dedup")
  @@index([userId, recordedAt])
}

model Workout {
  id String @id @default(cuid())

  type String

  source String

  title String?

  description String?

  deviceId String?

  startedAt DateTime

  endedAt DateTime

  duration Int

  calories Float?

  activeCalories Float?

  distance Float?

  steps Int?

  elevation Float?

  averageSpeed Float?

  maxSpeed Float?

  averagePace Float?

  averageHeartRate Float?

  maxHeartRate Float?

  cadence Float?

  power Float?

  vo2Max Float?

  trainingLoad Float?

  recoveryTime Float?

  perceivedEffort Float?

  notes String?

  createdAt DateTime @default(now())

  exercises WorkoutExercise[]

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutExercise {
  id String @id @default(cuid())

  name String

  duration Int?

  distance Float?

  calories Float?

  notes String?

  createdAt DateTime @default(now())

  workoutId String

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  sets WorkoutSet[]
}

model WorkoutSet {
  id String @id @default(cuid())

  reps Int?

  weight Float?

  duration Int?

  distance Float?

  rest Int?

  rir Float?

  rpe Float?

  completed Boolean?

  createdAt DateTime @default(now())

  exerciseId String

  exercise WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}
model ConnectedProvider {
  id String @id @default(cuid())

  provider String

  providerUserId String?

  accessToken String?

  refreshToken String?

  expiresAt DateTime?

  lastSyncAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  userId String

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}