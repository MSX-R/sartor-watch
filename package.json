{
  "name": "sartor-watch",
  "private": true,
  "workspaces": [
    "apps/sartor-web",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=sartor-web",
    "dev:mobile": "npm run dev --prefix apps/sartor-mobile",
    "build": "turbo run build"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
